<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Analytics — BreachLens</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="grid-bg">
<div class="scanline"></div>
<div style="position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0">
  <div class="orb orb-indigo" style="width:550px;height:550px;top:-20%;right:-12%;opacity:.20;"></div>
  <div class="orb orb-purple" style="width:400px;height:400px;bottom:-14%;left:-8%;opacity:.15;animation-delay:-4s;"></div>
  <div class="orb orb-cyan" style="width:240px;height:240px;top:40%;left:30%;opacity:.10;animation-delay:-9s;"></div>
</div>
<div id="toast-container"></div>

<nav id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon"><svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
    <div><div class="brand">BreachLens</div><div class="brand-sub">AI Security</div></div>
  </div>
  <div class="sidebar-nav">
    <div class="sidebar-section-label">Main</div>
    <a href="/dashboard" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10-3a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"/></svg><span class="label">Dashboard</span></a>
    <a href="/history" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg><span class="label">History</span></a>
    <a href="/analytics" class="nav-link active"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg><span class="label">Analytics</span></a>
    <div class="nav-divider"></div>
    <div class="sidebar-section-label">Account</div>
    <a href="/profile" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg><span class="label">Profile</span></a>
    <a href="/settings" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/></svg><span class="label">Settings</span></a>
    <div class="nav-divider"></div>
    <a href="/logout" class="nav-link danger"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg><span class="label">Sign Out</span></a>
  </div>
  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="avatar-circle"><%= user.name.slice(0,2).toUpperCase() %></div>
      <div style="overflow:hidden;min-width:0"><div class="uname"><%= user.name %></div><div class="uemail"><%= user.email %></div></div>
    </div>
    <div style="margin-top:8px;padding:0 10px;"><div class="role-badge"><svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>Analyst</div></div>
  </div>
</nav>

<div id="main">
  <div id="topbar">
    <div style="display:flex;align-items:center;gap:14px">
      <button class="toggle-btn" id="sidebarToggle"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <div>
        <div style="font-size:.7rem;color:var(--text-faint);font-weight:500;letter-spacing:.04em;text-transform:uppercase;">Insights</div>
        <div class="page-title" style="font-size:1.05rem;">Analytics</div>
      </div>
    </div>
    <div class="topbar-right">
      <div id="clock"></div>
      <div class="avatar-circle" style="width:36px;height:36px;font-size:.73rem;flex-shrink:0"><%= user.name.slice(0,2).toUpperCase() %></div>
    </div>
  </div>

  <div class="page-content">

    <!-- KPI row -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:22px;" id="kpiRow">
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#6366f1,#8b5cf6);"><div class="stat-icon" style="background:rgba(99,102,241,0.12);"><svg width="18" height="18" fill="none" stroke="#818cf8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6"/></svg></div><div class="stat-value" id="k-total" style="color:#818cf8;">0</div><div class="stat-label">Total Predictions</div></div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#f87171,#fb923c);animation-delay:.06s;"><div class="stat-icon" style="background:rgba(248,113,113,0.1);"><svg width="18" height="18" fill="none" stroke="#f87171" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div><div class="stat-value" id="k-highrisk" style="color:#f87171;">0%</div><div class="stat-label">High/Critical Rate</div></div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#fbbf24,#f59e0b);animation-delay:.12s;"><div class="stat-icon" style="background:rgba(251,191,36,0.08);"><svg width="18" height="18" fill="none" stroke="#fbbf24" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg></div><div class="stat-value mono" id="k-avgrisk" style="color:#fbbf24;">0</div><div class="stat-label">Avg Risk Score</div></div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#34d399,#10b981);animation-delay:.18s;"><div class="stat-icon" style="background:rgba(52,211,153,0.08);"><svg width="18" height="18" fill="none" stroke="#34d399" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8m0 0v1"/></svg></div><div class="stat-value mono" id="k-exposure" style="color:#34d399;font-size:1.35rem;">$0</div><div class="stat-label">Total Exposure</div></div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#c084fc,#a855f7);animation-delay:.24s;"><div class="stat-icon" style="background:rgba(192,132,252,0.1);"><svg width="18" height="18" fill="none" stroke="#c084fc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M12 6v6l4 2"/></svg></div><div class="stat-value mono" id="k-avgdetect" style="color:#c084fc;">0h</div><div class="stat-label">Avg Detection Time</div></div>
    </div>

    <!-- Charts row 1 -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;" class="chart-row">

      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.28s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg></div>Severity Breakdown</div>
        <div style="max-height:200px;display:flex;align-items:center;justify-content:center;"><canvas id="sevChart" height="200"></canvas></div>
        <div id="sevLegend" style="display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:14px;"></div>
      </div>

      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.33s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div>Breaches by Industry</div>
        <div style="max-height:200px;"><canvas id="industryChart" height="200"></canvas></div>
      </div>
    </div>

    <!-- Charts row 2 -->
    <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:20px;margin-bottom:20px;" class="chart-row">

      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.38s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg></div>Risk Score Over Time</div>
        <div style="max-height:220px;"><canvas id="trendChart" height="220"></canvas></div>
      </div>

      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.43s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>Data Exposure by Geography</div>
        <div style="max-height:220px;"><canvas id="geoChart" height="220"></canvas></div>
      </div>
    </div>

    <!-- Attack vector + Data type row -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;" class="chart-row">
      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.46s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>Avg Risk by Attack Vector</div>
        <div style="max-height:200px;"><canvas id="attackChart" height="200"></canvas></div>
      </div>
      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.50s;">
        <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg></div>Financial Impact by Data Type</div>
        <div style="max-height:200px;"><canvas id="dataTypeChart" height="200"></canvas></div>
      </div>
    </div>

    <!-- Top incidents table -->
    <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.54s;margin-bottom:8px;">
      <div class="section-title"><div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div>Top 5 Highest Risk Incidents</div>
      <div style="overflow-x:auto;">
        <table class="breach-table" id="topTable" style="min-width:640px;">
          <thead><tr><th>Rank</th><th>Industry</th><th>Attack</th><th>Records</th><th>Severity</th><th>Risk</th><th>Impact</th></tr></thead>
          <tbody id="topBody"><tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text-faint);">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<style>
  .page-content{position:relative;z-index:1;}
  @media(max-width:860px){.chart-row{grid-template-columns:1fr!important;}}
</style>

<script>
  document.getElementById('sidebarToggle').addEventListener('click',()=>{document.getElementById('sidebar').classList.toggle('collapsed');document.getElementById('main').classList.toggle('expanded');});
  function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true});}tick();setInterval(tick,1000);

  Chart.defaults.color='rgba(248,250,252,0.4)';
  Chart.defaults.font.family="'Inter', sans-serif";
  var charts={};

  function mk(id){if(charts[id]){charts[id].destroy();}return document.getElementById(id);}
  function fmtM(n){if(n>=1e9)return '$'+(n/1e9).toFixed(1)+'B';if(n>=1e6)return '$'+(n/1e6).toFixed(1)+'M';if(n>=1e3)return '$'+(n/1e3).toFixed(0)+'K';return '$'+(n||0).toFixed(0);}
  function sevBadge(s){var m={Low:'badge-low',Medium:'badge-medium',High:'badge-high',Critical:'badge-critical'};return '<span class="badge '+(m[s]||'badge-unknown')+'">'+s+'</span>';}

  const TP={
    tooltip:{backgroundColor:'rgba(6,12,26,0.95)',borderColor:'rgba(255,255,255,0.1)',borderWidth:1,padding:10},
    legend:{display:false},
  };
  const SCALE_X={grid:{color:'rgba(255,255,255,.03)'},ticks:{color:'rgba(248,250,252,0.35)',font:{size:10}}};
  const SCALE_Y={grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'rgba(248,250,252,0.35)'},border:{display:false}};

  async function loadAnalytics(){
    try{
      var r=await fetch('/api/history');
      var data=await r.json();
      if(!Array.isArray(data)||!data.length){
        document.getElementById('topBody').innerHTML='<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-faint);">No predictions yet. <a href="/dashboard" style="color:var(--indigo-light);">Run your first analysis →</a></td></tr>';
        return;
      }

      // KPIs
      var total=data.length;
      var hiCrit=data.filter(d=>d.severity==='High'||d.severity==='Critical').length;
      var avgRisk=Math.round(data.reduce((s,d)=>s+(d.riskScore||0),0)/total);
      var totExp=data.reduce((s,d)=>s+(d.financialImpact||0),0);
      var avgDet=+(data.reduce((s,d)=>s+(d.detection_time_hours||0),0)/total).toFixed(1);
      document.getElementById('k-total').textContent=total;
      document.getElementById('k-highrisk').textContent=Math.round(hiCrit/total*100)+'%';
      document.getElementById('k-avgrisk').textContent=avgRisk;
      document.getElementById('k-exposure').textContent=fmtM(totExp);
      document.getElementById('k-avgdetect').textContent=avgDet+'h';

      // Severity donut
      var sc={Low:0,Medium:0,High:0,Critical:0};
      data.forEach(d=>{if(sc[d.severity]!==undefined)sc[d.severity]++;});
      charts.sev=new Chart(mk('sevChart'),{type:'doughnut',data:{labels:['Low','Medium','High','Critical'],datasets:[{data:[sc.Low,sc.Medium,sc.High,sc.Critical],backgroundColor:['rgba(52,211,153,.18)','rgba(251,191,36,.18)','rgba(248,113,113,.18)','rgba(192,132,252,.18)'],borderColor:['#34d399','#fbbf24','#f87171','#c084fc'],borderWidth:2,hoverOffset:8}]},options:{cutout:'68%',responsive:true,maintainAspectRatio:false,plugins:{...TP,legend:{display:false}}}});
      document.getElementById('sevLegend').innerHTML=[{c:'#34d399',l:'Low',v:sc.Low},{c:'#fbbf24',l:'Medium',v:sc.Medium},{c:'#f87171',l:'High',v:sc.High},{c:'#c084fc',l:'Critical',v:sc.Critical}].map(i=>'<span style="display:flex;align-items:center;gap:5px;font-size:.72rem;color:var(--text-muted);"><span style="width:8px;height:8px;border-radius:50%;background:'+i.c+';box-shadow:0 0 5px '+i.c+';"></span>'+i.l+' <strong style="color:var(--text)">'+i.v+'</strong></span>').join('');

      // Industry bar
      var ind={};data.forEach(d=>{var k=d.industry||'other';ind[k]=(ind[k]||0)+1;});
      var indL=Object.keys(ind).sort((a,b)=>ind[b]-ind[a]);
      var indV=indL.map(k=>ind[k]);
      charts.ind=new Chart(mk('industryChart'),{type:'bar',data:{labels:indL,datasets:[{label:'Predictions',data:indV,backgroundColor:'rgba(99,102,241,.28)',borderColor:'#818cf8',borderWidth:1.5,borderRadius:6,hoverBorderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{...TP},scales:{x:{...SCALE_X,min:0},y:{...SCALE_Y}}}});

      // Risk score trend (line)
      var sorted=[...data].sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));
      var trendLabels=sorted.map(d=>new Date(d.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}));
      var trendVals=sorted.map(d=>d.riskScore||0);
      charts.trend=new Chart(mk('trendChart'),{type:'line',data:{labels:trendLabels,datasets:[{label:'Risk Score',data:trendVals,borderColor:'#818cf8',backgroundColor:'rgba(99,102,241,0.07)',fill:true,tension:0.45,pointRadius:4,pointBackgroundColor:'#818cf8',pointBorderColor:'rgba(6,12,26,0.8)',pointBorderWidth:2,pointHoverRadius:6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{...TP,legend:{display:false}},scales:{x:{...SCALE_X},y:{...SCALE_Y,min:0,max:100}}}});

      // Geography pie (financial)
      var geo={};data.forEach(d=>{var k=(d.geography||'unknown').replace(/_/g,' ');geo[k]=(geo[k]||0)+(d.financialImpact||0);});
      var geoL=Object.keys(geo),geoV=geoL.map(k=>geo[k]);
      var gColors=['#818cf8','#34d399','#fbbf24','#f87171','#c084fc','#22d3ee'];
      charts.geo=new Chart(mk('geoChart'),{type:'polarArea',data:{labels:geoL,datasets:[{data:geoV,backgroundColor:gColors.slice(0,geoL.length).map(c=>c+'33'),borderColor:gColors.slice(0,geoL.length),borderWidth:1.5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{...TP,legend:{display:true,position:'right',labels:{font:{size:10},boxWidth:10,color:'rgba(248,250,252,0.5)'}},tooltip:{callbacks:{label:ctx=>' '+ctx.label+': '+fmtM(ctx.parsed.r)}}},scales:{r:{grid:{color:'rgba(255,255,255,.06)'},ticks:{display:false}}}}});

      // Attack vector avg risk
      var atk={};data.forEach(d=>{var k=(d.attack_vector||'unknown').replace(/_/g,' ');if(!atk[k])atk[k]={s:0,c:0};atk[k].s+=(d.riskScore||0);atk[k].c++;});
      var atkL=Object.keys(atk),atkV=atkL.map(k=>+(atk[k].s/atk[k].c).toFixed(1));
      charts.atk=new Chart(mk('attackChart'),{type:'bar',data:{labels:atkL,datasets:[{label:'Avg Risk',data:atkV,backgroundColor:atkV.map(v=>v>=80?'rgba(248,113,113,.3)':v>=60?'rgba(251,191,36,.28)':'rgba(99,102,241,.28)'),borderColor:atkV.map(v=>v>=80?'#f87171':v>=60?'#fbbf24':'#818cf8'),borderWidth:1.5,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{...TP},scales:{x:{...SCALE_X},y:{...SCALE_Y,min:0,max:100}}}});

      // Data type financial impact
      var dti={};data.forEach(d=>{var k=(d.data_type||'unknown').replace(/_/g,' ');dti[k]=(dti[k]||0)+(d.financialImpact||0);});
      var dtiL=Object.keys(dti).sort((a,b)=>dti[b]-dti[a]),dtiV=dtiL.map(k=>dti[k]);
      charts.dti=new Chart(mk('dataTypeChart'),{type:'bar',data:{labels:dtiL,datasets:[{label:'Impact',data:dtiV,backgroundColor:'rgba(52,211,153,.2)',borderColor:'#34d399',borderWidth:1.5,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{...TP,tooltip:{...TP.tooltip,callbacks:{label:ctx=>' '+fmtM(ctx.parsed.x)}}},scales:{x:{...SCALE_X,ticks:{callback:v=>fmtM(v),font:{size:9}}},y:{...SCALE_Y}}}});

      // Top 5 table
      var top5=[...data].sort((a,b)=>(b.riskScore||0)-(a.riskScore||0)).slice(0,5);
      document.getElementById('topBody').innerHTML=top5.map((d,i)=>{
        var atk2=(d.attack_vector||'—').replace(/_/g,' ');
        var rec=d.records_affected?Number(d.records_affected).toLocaleString():'—';
        return '<tr><td><span style="width:26px;height:26px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;background:'+(i===0?'rgba(251,191,36,0.15)':i===1?'rgba(192,132,252,0.12)':'rgba(255,255,255,0.05)')+';color:'+(i===0?'#fbbf24':i===1?'#c084fc':'var(--text-muted)')+';">'+(i+1)+'</span></td><td style="text-transform:capitalize;font-weight:600;">'+d.industry+'</td><td style="text-transform:capitalize;">'+atk2+'</td><td class="mono" style="font-size:.8rem;">'+rec+'</td><td>'+sevBadge(d.severity)+'</td><td class="mono" style="font-weight:700;color:var(--yellow);">'+(d.riskScore||'—')+'</td><td class="mono" style="color:#34d399;font-weight:700;">'+fmtM(d.financialImpact)+'</td></tr>';
      }).join('');

    }catch(e){console.error(e);document.getElementById('topBody').innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--red);padding:32px;">Failed to load data.</td></tr>';}
  }
  loadAnalytics();
</script>
</body>
</html>
