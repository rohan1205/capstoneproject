<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password — BreachLens</title>
  <meta name="description" content="Reset your BreachLens password"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#030712;--indigo:#6366f1;--purple:#8b5cf6;--violet:#a855f7;
      --text:#f8fafc;--muted:rgba(248,250,252,0.55);--faint:rgba(248,250,252,0.30);
      --border:rgba(255,255,255,0.08);--radius:14px;--tr:0.28s cubic-bezier(0.23,1,0.32,1);
    }
    html,body{height:100%;font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
    body{background:var(--bg);color:var(--text);display:flex;min-height:100vh;overflow:hidden;}

    .auth-panel{
      flex:1;display:flex;align-items:center;justify-content:center;
      padding:24px;position:relative;overflow-y:auto;
      background:var(--bg);
    }
    .auth-panel::before{
      content:'';position:absolute;left:0;top:0;bottom:0;width:40px;
      background:linear-gradient(90deg,rgba(99,102,241,0.04),transparent);
      pointer-events:none;
    }

    .auth-shape{
      position:absolute;border-radius:18px;
      background:linear-gradient(135deg,rgba(99,102,241,0.06),rgba(139,92,246,0.03));
      border:1px solid rgba(255,255,255,0.06);
      pointer-events:none;
    }
    .auth-shape-1{width:100px;height:100px;top:8%;right:6%;animation:shapeFloat 20s ease-in-out infinite;}
    .auth-shape-2{width:65px;height:65px;bottom:12%;left:6%;animation:shapeFloat 26s ease-in-out infinite reverse;animation-delay:-7s;}
    .auth-shape-3{width:40px;height:40px;top:55%;right:10%;animation:shapeFloat 17s ease-in-out infinite;animation-delay:-4s;}
    @keyframes shapeFloat{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-16px) rotate(4deg);}}

    .form-box{
      width:100%;max-width:420px;position:relative;z-index:2;
    }
    .form-box{animation:cardUp 0.85s cubic-bezier(0.23,1,0.32,1) both;}
    @keyframes cardUp{from{opacity:0;transform:translateY(28px) scale(0.97);}to{opacity:1;transform:translateY(0) scale(1);}}

    .form-header{text-align:center;margin-bottom:36px;}
    .form-logo{
      width:52px;height:52px;border-radius:14px;margin:0 auto 18px;
      background:linear-gradient(135deg,#4f46e5,#7c3aed,#9333ea);
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 8px 28px rgba(99,102,241,0.45),0 0 0 1px rgba(255,255,255,0.1) inset;
      transition:all 0.4s ease;
    }
    .form-logo svg{width:26px;height:26px;color:#fff;}
    .form-title{font-size:1.7rem;font-weight:800;letter-spacing:-0.03em;margin-bottom:6px;}
    .form-subtitle{font-size:0.87rem;color:var(--muted);line-height:1.5;}

    @media(max-width:899px){
      .form-box{
        background:linear-gradient(145deg,rgba(255,255,255,0.07) 0%,rgba(255,255,255,0.02) 100%);
        border:1px solid rgba(255,255,255,0.12);
        border-radius:24px;
        padding:36px 28px;
        backdrop-filter:blur(24px);
        box-shadow:0 32px 80px -20px rgba(0,0,0,0.7),inset 0 1px 0 rgba(255,255,255,0.08);
      }
    }

    .input-group{position:relative;margin-bottom:20px;}
    .input-group label{
      position:absolute;left:46px;top:50%;transform:translateY(-50%);
      color:rgba(248,250,252,0.3);font-size:0.9rem;font-weight:400;
      pointer-events:none;transition:all var(--tr);
    }
    .input-group input:focus ~ label,
    .input-group input:not(:placeholder-shown) ~ label{
      top:-11px;left:12px;font-size:0.68rem;font-weight:700;letter-spacing:0.07em;
      color:#818cf8;padding:0 6px;text-transform:uppercase;
      background:linear-gradient(180deg,var(--bg) 60%,transparent 40%);
    }
    .input-group .i-icon{
      position:absolute;left:15px;top:50%;transform:translateY(-50%);
      color:rgba(248,250,252,0.25);pointer-events:none;
      transition:color var(--tr),transform var(--tr);
    }
    .input-group input:focus ~ .i-icon{color:#818cf8;transform:translateY(-50%) scale(1.08);}
    .field{
      width:100%;padding:16px 16px 16px 46px;border-radius:var(--radius);
      background:rgba(255,255,255,0.04);border:1px solid var(--border);
      color:var(--text);font-family:'Inter',sans-serif;font-size:0.9375rem;
      outline:none;transition:all var(--tr);
    }
    .field::placeholder{color:transparent;}
    .field:focus{
      border-color:rgba(99,102,241,0.6);background:rgba(255,255,255,0.06);
      box-shadow:0 0 0 3px rgba(99,102,241,0.14),0 0 30px rgba(99,102,241,0.05),inset 0 1px 0 rgba(255,255,255,0.06);
    }
    .field-pw{padding-right:52px;}

    .pw-toggle{
      position:absolute;right:4px;top:50%;transform:translateY(-50%);
      width:38px;height:38px;border-radius:10px;border:none;background:none;
      color:rgba(248,250,252,0.3);cursor:pointer;transition:all var(--tr);
      display:flex;align-items:center;justify-content:center;
    }
    .pw-toggle:hover{background:rgba(255,255,255,0.06);color:#818cf8;}

    .btn-primary{
      width:100%;padding:15px;border-radius:var(--radius);border:1px solid rgba(139,92,246,0.5);
      background:linear-gradient(135deg,#4f46e5,#7c3aed 50%,#9333ea);
      background-size:200% 200%;color:#fff;font-family:'Inter',sans-serif;
      font-size:0.95rem;font-weight:700;letter-spacing:0.01em;
      cursor:pointer;transition:all var(--tr);
      position:relative;overflow:hidden;
      box-shadow:0 0 0 1px rgba(255,255,255,0.1) inset,0 0 40px rgba(99,102,241,0.3),0 8px 32px -8px rgba(99,102,241,0.5);
    }
    .btn-primary::before{
      content:'';position:absolute;inset:0;
      background:linear-gradient(130deg,transparent 25%,rgba(255,255,255,0.18) 50%,transparent 75%);
      transform:translateX(-120%) skewX(-15deg);transition:transform 0.7s ease;
    }
    .btn-primary:hover{
      transform:translateY(-2px) scale(1.01);background-position:100% 100%;
      box-shadow:0 0 0 1px rgba(255,255,255,0.15) inset,0 0 60px rgba(139,92,246,0.45),0 12px 48px -8px rgba(99,102,241,0.55);
    }
    .btn-primary:hover::before{transform:translateX(120%) skewX(-15deg);}
    .btn-primary:active{transform:translateY(0) scale(0.985);}
    .btn-primary:disabled{opacity:0.6;cursor:not-allowed;}

    .alert-err{
      display:flex;align-items:flex-start;gap:10px;padding:13px 15px;
      border-radius:var(--radius);background:rgba(248,113,113,0.07);
      border:1px solid rgba(248,113,113,0.22);color:#fca5a5;font-size:0.855rem;
      margin-bottom:22px;line-height:1.5;
      animation:alertIn 0.4s cubic-bezier(0.23,1,0.32,1) both;
    }
    @keyframes alertIn{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}

    .form-footer{text-align:center;margin-top:26px;font-size:0.875rem;color:var(--faint);}
    .form-footer a{color:#818cf8;font-weight:600;text-decoration:none;transition:color var(--tr);}
    .form-footer a:hover{color:#c4b5fd;}

    .pwd-requirements{
      margin-top:20px;padding:14px;border-radius:var(--radius);
      background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.15);
      font-size:0.8rem;color:var(--muted);
    }
    .requirement{margin:6px 0;display:flex;align-items:center;gap:8px;}
    .requirement.met{color:#34d399;}
    .req-icon{width:14px;height:14px;display:flex;align-items:center;justify-content:center;}
  </style>
</head>
<body>

  <div class="auth-panel" id="auth-bg">
    <div class="auth-shape auth-shape-1"></div>
    <div class="auth-shape auth-shape-2"></div>
    <div class="auth-shape auth-shape-3"></div>

    <div class="form-box">

      <div class="form-header">
        <div class="form-logo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div class="form-title">Reset Password</div>
        <div class="form-subtitle">Enter your new password below.</div>
      </div>

      <!-- Error alert -->
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert-err" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f87171" style="flex-shrink:0;margin-top:1px" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Reset Password Form -->
      <form action="/reset-password/<%= token %>" method="POST" id="resetForm" novalidate>
        <!-- New Password -->
        <div class="input-group">
          <input type="password" name="newPassword" id="newPassword" placeholder=" " required class="field field-pw" data-password="true"/>
          <svg class="i-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <button type="button" class="pw-toggle" data-target="newPassword" aria-label="Toggle password">
            <svg class="eye-on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <svg class="eye-off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="display:none"><path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M4.031 11.117A8.959 8.959 0 003 12c0 4.478 2.943 8.268 7 9.543 3.947-1.192 7.26-3.408 9.542-7.187m-1.746-2.117A9.97 9.97 0 0112 5c4.478 0 8.268 2.943 9.542 7"/></svg>
          </button>
          <label for="newPassword">New password</label>
        </div>

        <!-- Confirm Password -->
        <div class="input-group">
          <input type="password" name="confirmPassword" id="confirmPassword" placeholder=" " required class="field field-pw"/>
          <svg class="i-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <button type="button" class="pw-toggle" data-target="confirmPassword" aria-label="Toggle password">
            <svg class="eye-on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <svg class="eye-off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="display:none"><path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M4.031 11.117A8.959 8.959 0 003 12c0 4.478 2.943 8.268 7 9.543 3.947-1.192 7.26-3.408 9.542-7.187m-1.746-2.117A9.97 9.97 0 0112 5c4.478 0 8.268 2.943 9.542 7"/></svg>
          </button>
          <label for="confirmPassword">Confirm password</label>
        </div>

        <!-- Password Requirements -->
        <div class="pwd-requirements">
          <div class="requirement" id="req-length">
            <span class="req-icon">○</span>
            At least 8 characters
          </div>
          <div class="requirement" id="req-upper">
            <span class="req-icon">○</span>
            One uppercase letter
          </div>
          <div class="requirement" id="req-lower">
            <span class="req-icon">○</span>
            One lowercase letter
          </div>
          <div class="requirement" id="req-number">
            <span class="req-icon">○</span>
            One number
          </div>
          <div class="requirement" id="req-match">
            <span class="req-icon">○</span>
            Passwords match
          </div>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn" style="margin-top:20px;">
          <span id="btnText">Reset Password</span>
        </button>
      </form>

      <p class="form-footer">
        <a href="/login">Back to sign in &rarr;</a>
      </p>
    </div>
  </div>

<script>
(function(){
  // Password toggle
  document.querySelectorAll('.pw-toggle').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      const targetId = this.getAttribute('data-target');
      const input = document.getElementById(targetId);
      const eyeOn = this.querySelector('.eye-on');
      const eyeOff = this.querySelector('.eye-off');
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      eyeOn.style.display = show ? 'none' : '';
      eyeOff.style.display = show ? '' : 'none';
    });
  });

  // Real-time password validation
  const pwInput = document.getElementById('newPassword');
  const confirmInput = document.getElementById('confirmPassword');

  function validatePassword() {
    const pwd = pwInput.value;
    const confirm = confirmInput.value;

    document.getElementById('req-length').classList.toggle('met', pwd.length >= 8);
    document.getElementById('req-upper').classList.toggle('met', /[A-Z]/.test(pwd));
    document.getElementById('req-lower').classList.toggle('met', /[a-z]/.test(pwd));
    document.getElementById('req-number').classList.toggle('met', /\d/.test(pwd));
    document.getElementById('req-match').classList.toggle('met', pwd && confirm && pwd === confirm);
  }

  pwInput.addEventListener('input', validatePassword);
  confirmInput.addEventListener('input', validatePassword);

  // Form submit
  document.getElementById('resetForm').addEventListener('submit', function(){
    var btn  = document.getElementById('submitBtn');
    var txt  = document.getElementById('btnText');
    btn.disabled = true;
    txt.textContent = 'Resetting…';
    btn.style.opacity = '0.8';
  });
})();
</script>
</body>
</html>
