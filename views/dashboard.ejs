<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard — BreachLens</title>
  <meta name="description" content="BreachLens AI Dashboard — Real-time breach severity prediction, risk scoring, and incident response."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="grid-bg">
<div class="scanline"></div>

<!-- ══ AMBIENT ══ -->
<div style="position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0">
  <div class="orb orb-indigo"  style="width:600px;height:600px;top:-20%;right:-15%;opacity:.22;"></div>
  <div class="orb orb-purple"  style="width:440px;height:440px;bottom:-12%;left:-10%;opacity:.18;animation-delay:-5s;"></div>
  <div class="orb orb-violet"  style="width:280px;height:280px;top:42%;left:32%;opacity:.12;animation-delay:-8s;animation-duration:13s;"></div>
  <div class="orb orb-cyan"    style="width:200px;height:200px;bottom:20%;right:20%;opacity:.10;animation-delay:-3s;"></div>
</div>

<!-- ══ TOAST ══ -->
<div id="toast-container"></div>

<!-- ════════════════════════════════════
     SIDEBAR
════════════════════════════════════ -->
<nav id="sidebar">
  <!-- Top accent line -->
  <div class="sidebar-logo">
    <div class="logo-icon">
      <svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
    </div>
    <div>
      <div class="brand">BreachLens</div>
      <div class="brand-sub">AI Security</div>
    </div>
  </div>

  <div class="sidebar-nav">
    <div class="sidebar-section-label">Main</div>

    <a href="/dashboard" class="nav-link active" id="nav-dash">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10-3a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"/></svg>
      <span class="label">Dashboard</span>
    </a>

    <a href="/history" class="nav-link">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      <span class="label">History</span>
    </a>

    <a href="/analytics" class="nav-link">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      <span class="label">Analytics</span>
    </a>

    <div class="nav-divider"></div>
    <div class="sidebar-section-label">Account</div>

    <a href="/profile" class="nav-link">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span class="label">Profile</span>
    </a>

    <a href="/settings" class="nav-link">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/></svg>
      <span class="label">Settings</span>
    </a>

    <div class="nav-divider"></div>

    <a href="/logout" class="nav-link danger">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      <span class="label">Sign Out</span>
    </a>
  </div>

  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="avatar-circle" id="avatarCircle">??</div>
      <div style="overflow:hidden;min-width:0">
        <div class="uname" id="sidebarName"><%= user.name %></div>
        <div class="uemail" id="sidebarEmail"><%= user.email %></div>
      </div>
    </div>
    <div style="margin-top:8px;padding:0 10px;">
      <div class="role-badge">
        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        Analyst
      </div>
    </div>
  </div>
</nav>

<!-- ════════════════════════════════════
     MAIN
════════════════════════════════════ -->
<div id="main">

  <!-- ── Topbar ── -->
  <div id="topbar">
    <div style="display:flex;align-items:center;gap:14px">
      <button class="toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div>
        <div style="font-size:.7rem;color:var(--text-faint);font-weight:500;letter-spacing:.04em;text-transform:uppercase;">Welcome back</div>
        <div class="page-title" style="font-size:1.05rem;"><%- user.name.split(' ')[0] %>'s Dashboard</div>
      </div>
    </div>

    <div class="topbar-right">
      <!-- ML Status -->
      <div style="display:flex;align-items:center;gap:7px;padding:6px 12px;border-radius:99px;background:rgba(52,211,153,0.07);border:1px solid rgba(52,211,153,0.18);">
        <div class="status-dot"></div>
        <span style="font-size:.72rem;font-weight:600;color:#34d399;font-family:'JetBrains Mono',monospace;">ML API</span>
      </div>
      <!-- Clock -->
      <div id="clock" style="min-width:90px;text-align:right;">--:--:--</div>
      <!-- Avatar -->
      <div class="avatar-circle" style="width:36px;height:36px;font-size:.73rem;flex-shrink:0" id="topAvatar">??</div>
    </div>
  </div>

  <!-- ── Page Content ── -->
  <div class="page-content">

    <!-- ░░ STAT CARDS ░░ -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin-bottom:26px">

      <div class="glass glass-hover stat-card fade-in" style="--card-accent:linear-gradient(90deg,#6366f1,#8b5cf6);animation-delay:.0s;border-radius:var(--radius);">
        <div class="stat-icon" style="background:rgba(99,102,241,0.14);">
          <svg width="20" height="20" fill="none" stroke="#818cf8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div class="stat-value counter" id="statTotal">0</div>
        <div class="stat-label">Total Predictions</div>
        <div class="stat-trend up" id="statTotalTrend" style="display:none">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 15l7-7 7 7"/></svg>
          <span id="statTotalTrendVal"></span>
        </div>
      </div>

      <div class="glass glass-hover stat-card fade-in" style="--card-accent:linear-gradient(90deg,#f87171,#fb923c);animation-delay:.08s;border-radius:var(--radius);">
        <div class="stat-icon" style="background:rgba(248,113,113,0.12);">
          <svg width="20" height="20" fill="none" stroke="#f87171" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div class="stat-value counter" id="statCritical" style="color:#f87171">0</div>
        <div class="stat-label">High / Critical</div>
      </div>

      <div class="glass glass-hover stat-card fade-in" style="--card-accent:linear-gradient(90deg,#fbbf24,#f59e0b);animation-delay:.14s;border-radius:var(--radius);">
        <div class="stat-icon" style="background:rgba(251,191,36,0.10);">
          <svg width="20" height="20" fill="none" stroke="#fbbf24" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <div class="stat-value counter mono" id="statAvgRisk" style="color:#fbbf24">0</div>
        <div class="stat-label">Avg Risk Score</div>
      </div>

      <div class="glass glass-hover stat-card fade-in" style="--card-accent:linear-gradient(90deg,#34d399,#10b981);animation-delay:.20s;border-radius:var(--radius);">
        <div class="stat-icon" style="background:rgba(52,211,153,0.10);">
          <svg width="20" height="20" fill="none" stroke="#34d399" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
        </div>
        <div id="statFinancial" style="font-size:1.5rem;font-weight:800;line-height:1;letter-spacing:-0.02em;color:#34d399;font-family:'JetBrains Mono',monospace;">$0</div>
        <div class="stat-label">Total Financial Exposure</div>
      </div>

    </div>

    <!-- ░░ PREDICTION + RESULT ROW ░░ -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px" class="predict-row">

      <!-- ── Prediction Form ── -->
      <div class="glass fade-in" style="border-radius:var(--radius);padding:28px;animation-delay:.25s;position:relative;overflow:hidden;">
        <!-- Holographic shimmer -->
        <div class="holo-shimmer" style="position:absolute;inset:0;pointer-events:none;border-radius:inherit;"></div>

        <div class="section-title">
          <div class="section-title-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
          </div>
          AI Breach Analysis
        </div>

        <form id="predictForm" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;position:relative;z-index:1">

          <!-- Industry -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <select class="field-input" name="industry" id="f-industry" required>
              <option value="" disabled selected hidden></option>
              <option value="healthcare">Healthcare</option>
              <option value="finance">Finance</option>
              <option value="technology">Technology</option>
              <option value="retail">Retail</option>
              <option value="government">Government</option>
              <option value="education">Education</option>
              <option value="manufacturing">Manufacturing</option>
              <option value="energy">Energy</option>
              <option value="legal">Legal</option>
              <option value="hospitality">Hospitality</option>
            </select>
            <label>Industry</label>
          </div>

          <!-- Attack Vector -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <select class="field-input" name="attack_vector" id="f-attack" required>
              <option value="" disabled selected hidden></option>
              <option value="phishing">Phishing</option>
              <option value="malware">Malware</option>
              <option value="ransomware">Ransomware</option>
              <option value="insider_threat">Insider Threat</option>
              <option value="sql_injection">SQL Injection</option>
              <option value="credential_stuffing">Credential Stuffing</option>
              <option value="ddos">DDoS</option>
              <option value="supply_chain">Supply Chain</option>
              <option value="zero_day">Zero Day</option>
              <option value="physical_breach">Physical Breach</option>
            </select>
            <label>Attack Vector</label>
          </div>

          <!-- Data Type -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
            <select class="field-input" name="data_type" id="f-datatype" required>
              <option value="" disabled selected hidden></option>
              <option value="pii">PII</option>
              <option value="financial">Financial</option>
              <option value="health">Health Records</option>
              <option value="credentials">Credentials</option>
              <option value="intellectual_property">Intellectual Property</option>
              <option value="government_classified">Government Classified</option>
              <option value="operational">Operational</option>
            </select>
            <label>Data Type</label>
          </div>

          <!-- Geography -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <select class="field-input" name="geography" id="f-geo" required>
              <option value="" disabled selected hidden></option>
              <option value="north_america">North America</option>
              <option value="europe">Europe</option>
              <option value="asia_pacific">Asia Pacific</option>
              <option value="middle_east">Middle East</option>
              <option value="latin_america">Latin America</option>
              <option value="africa">Africa</option>
            </select>
            <label>Geography</label>
          </div>

          <!-- Records Affected -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <input class="field-input" name="records_affected" id="f-records" type="number" min="1" max="100000000" step="1" placeholder=" " required/>
            <label>Records Affected</label>
          </div>

          <!-- Detection Time -->
          <div class="input-wrap">
            <svg class="icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M12 6v6l4 2"/></svg>
            <input class="field-input" name="detection_time_hours" id="f-detect" type="number" min="0.5" max="8760" step="0.5" placeholder=" " required/>
            <label>Detection Time (hrs)</label>
          </div>

          <button id="predictBtn" type="submit" class="glow-btn" style="grid-column:1/-1;padding:15px;border-radius:var(--radius-sm);font-size:.93rem;display:flex;align-items:center;justify-content:center;gap:9px;font-family:'Inter',sans-serif;letter-spacing:.01em;">
            <svg id="btnIcon" width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span id="btnLabel">Analyze Breach</span>
          </button>

        </form>
      </div>

      <!-- ── Result Panel ── -->
      <div class="glass fade-in" id="resultPanel" style="border-radius:var(--radius);padding:28px;animation-delay:.3s;display:flex;flex-direction:column;min-height:420px;position:relative;overflow:hidden;">

        <!-- Empty state -->
        <div id="resultEmpty" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:var(--text-faint);text-align:center;padding:20px;">
          <div style="width:72px;height:72px;border-radius:50%;background:rgba(99,102,241,0.08);border:1px dashed rgba(99,102,241,0.2);display:flex;align-items:center;justify-content:center;">
            <svg width="32" height="32" fill="none" stroke="rgba(99,102,241,0.4)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <div style="font-size:.94rem;font-weight:600;color:var(--text-muted);margin-bottom:4px;">Ready to Analyze</div>
            <div style="font-size:.8rem;line-height:1.6;">Fill the form and click<br><strong style="color:var(--indigo-light)">Analyze Breach</strong> to get AI predictions</div>
          </div>
          <!-- AI badge -->
          <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:99px;background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.18);font-size:.72rem;font-weight:600;color:var(--indigo-light);">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
            Powered by Random Forest + Gradient Boosting
          </div>
        </div>

        <!-- Result content -->
        <div id="resultContent" style="display:none;flex:1;flex-direction:column;gap:18px;">

          <!-- Header row -->
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div class="section-title" style="margin-bottom:0">
              <div class="section-title-icon">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              </div>
              Prediction Result
            </div>
            <span id="severityBadgeTop" class="badge badge-unknown">—</span>
          </div>

          <!-- Severity Gauge -->
          <div style="text-align:center;padding:8px 0;">
            <div class="gauge-wrap" style="width:200px;height:112px;">
              <svg viewBox="0 0 200 110" fill="none">
                <!-- Track -->
                <path d="M20 100 A80 80 0 0 1 180 100" stroke="rgba(255,255,255,0.06)" stroke-width="16" stroke-linecap="round"/>
                <!-- Fill -->
                <path id="gaugeFill" d="M20 100 A80 80 0 0 1 180 100" stroke="#6366f1" stroke-width="16" stroke-linecap="round"
                  stroke-dasharray="251" stroke-dashoffset="251"
                  style="transition:stroke-dashoffset 1.4s cubic-bezier(0.23,1,0.32,1),stroke 0.6s ease;filter:drop-shadow(0 0 8px currentColor)"/>
                <!-- Tick marks -->
                <line x1="20" y1="100" x2="28" y2="100" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
                <line x1="100" y1="20" x2="100" y2="28" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
                <line x1="180" y1="100" x2="172" y2="100" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
              </svg>
              <div style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);text-align:center;line-height:1;">
                <div id="gaugeValue" style="font-size:2rem;font-weight:900;letter-spacing:-0.04em;">—</div>
                <div style="font-size:.6rem;color:var(--text-faint);font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-top:2px;">SEVERITY</div>
              </div>
            </div>
          </div>

          <!-- Metrics row -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">

            <!-- Risk Score -->
            <div style="padding:16px;border-radius:12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);">
              <div style="font-size:.64rem;font-weight:700;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;">Risk Score</div>
              <div id="riskValue" style="font-size:2rem;font-weight:900;color:var(--yellow);letter-spacing:-0.03em;font-family:'JetBrains Mono',monospace;line-height:1;">—</div>
              <div class="progress-track" style="margin-top:10px;">
                <div id="riskBar" class="progress-fill" style="background:linear-gradient(90deg,#fbbf24,#f59e0b);width:0%;"></div>
              </div>
            </div>

            <!-- Financial Impact -->
            <div style="padding:16px;border-radius:12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);">
              <div style="font-size:.64rem;font-weight:700;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;">Financial Impact</div>
              <div id="impactValue" style="font-size:1.35rem;font-weight:800;color:var(--green);line-height:1.2;letter-spacing:-0.02em;font-family:'JetBrains Mono',monospace;">—</div>
              <div id="impactRaw" style="font-size:.68rem;color:var(--text-faint);margin-top:6px;">USD estimate</div>
            </div>

          </div>

          <!-- Model tag -->
          <div style="font-size:.68rem;color:var(--text-faint);display:flex;align-items:center;justify-content:space-between;">
            <span>Model: <span id="modelVersion" class="mono" style="color:var(--text-muted);">rf-v2</span></span>
            <span id="predTime">—</span>
          </div>

          <!-- Recommendations -->
          <div>
            <div style="font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px;">Response Actions</div>
            <div id="recommendations" style="display:flex;flex-direction:column;gap:6px;max-height:160px;overflow-y:auto;"></div>
          </div>

        </div>
      </div>
    </div><!-- /predict-row -->

    <!-- ░░ CHARTS ROW ░░ -->
    <div id="charts-section" style="display:grid;grid-template-columns:1fr 1.9fr;gap:20px;margin-bottom:24px" class="chart-row">

      <!-- Severity Donut -->
      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.35s;">
        <div class="section-title">
          <div class="section-title-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          Severity Distribution
        </div>
        <div style="max-height:190px;display:flex;align-items:center;justify-content:center;">
          <canvas id="severityChart" height="190"></canvas>
        </div>
        <div id="sevLegend" style="display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:14px;"></div>
      </div>

      <!-- Attack Vector Bar -->
      <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.40s;">
        <div class="section-title">
          <div class="section-title-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          Avg Risk Score by Attack Vector
        </div>
        <div style="max-height:200px;">
          <canvas id="attackChart" height="200"></canvas>
        </div>
      </div>
    </div>

    <!-- ░░ HISTORY TABLE ░░ -->
    <div class="glass fade-in" id="history-section" style="border-radius:var(--radius);padding:26px;animation-delay:.45s;margin-bottom:8px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
        <div class="section-title" style="margin-bottom:0">
          <div class="section-title-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          Recent Predictions
          <span id="histBadge" style="display:none;margin-left:4px;padding:2px 9px;border-radius:99px;background:rgba(99,102,241,0.15);color:var(--indigo-light);font-size:.69rem;font-weight:700;"></span>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <!-- Filter by severity -->
          <select id="sevFilter" style="padding:7px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--text-muted);font-family:'Inter',sans-serif;font-size:.78rem;outline:none;cursor:pointer;">
            <option value="">All Severities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
          </select>
          <button onclick="loadBreaches()" class="ghost-btn" style="padding:7px 14px;font-size:.78rem;font-weight:600;display:flex;align-items:center;gap:6px;" aria-label="Refresh">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v5h5M20 20v-5h-5"/><path d="M4 9a9 9 0 0114.24-3.24M20 15A9 9 0 015.76 18.24"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
        <table class="breach-table" style="min-width:740px;">
          <thead>
            <tr>
              <th>Industry</th>
              <th>Attack Vector</th>
              <th>Data Type</th>
              <th>Records</th>
              <th>Severity</th>
              <th>Risk Score</th>
              <th>Financial Impact</th>
              <th>Analyzed</th>
            </tr>
          </thead>
          <tbody id="breachTable">
            <tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-faint);">
              <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                <svg width="28" height="28" fill="none" stroke="rgba(255,255,255,0.2)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h5M20 20v-5h-5M4 9a9 9 0 0114.24-3.24M20 15A9 9 0 015.76 18.24"/></svg>
                Loading predictions...
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </div><!-- /page-content -->
</div><!-- /main -->

<!-- ── Responsive ── -->
<style>
  @media(max-width:900px){
    .predict-row,.chart-row{grid-template-columns:1fr!important;}
  }
  @media(max-width:640px){
    #sidebar{width:var(--sidebar-w-sm)!important;}
    #sidebar .brand,#sidebar .brand-sub,#sidebar .label,#sidebar .uname,#sidebar .uemail,#sidebar .role-badge{opacity:0!important;pointer-events:none!important;}
    #main{margin-left:var(--sidebar-w-sm)!important;}
  }
  .page-content{position:relative;z-index:1;}
</style>

<script>
/* ═══════════════════════════════════════════
   INIT
═══════════════════════════════════════════ */
const $ = s => document.querySelector(s);

// Set avatar initials
(function(){
  const name = '<%- user.name %>';
  const initials = name.split(' ').map(n=>n[0]).slice(0,2).join('').toUpperCase();
  document.querySelectorAll('#avatarCircle,#topAvatar').forEach(el => el.textContent = initials);
})();

// Clock
function updateClock(){
  const t = new Date();
  $('#clock').textContent = t.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true});
}
updateClock(); setInterval(updateClock, 1000);

// Sidebar toggle
const sidebar = $('#sidebar'), main = $('#main');
$('#sidebarToggle').addEventListener('click', () => {
  sidebar.classList.toggle('collapsed');
  main.classList.toggle('expanded');
});

// Scroll helpers
function scrollToHistory(){ const el=$('#history-section'); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }
function scrollToCharts(){  const el=$('#charts-section'); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }

/* ═══════════════════════════════════════════
   TOAST
═══════════════════════════════════════════ */
function toast(msg, type='success'){
  const c = $('#toast-container');
  const t = document.createElement('div');
  t.className = `toast toast-${type}`;
  const isOk = type === 'success';
  const col = isOk ? '#34d399' : '#f87171';
  const icon = isOk
    ? `<circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4"/>`
    : `<circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4m0 4h.01"/>`;
  t.innerHTML = `<svg class="toast-icon" fill="none" stroke="${col}" viewBox="0 0 24 24">${icon}</svg><div class="toast-msg">${msg}</div>`;
  c.appendChild(t);
  setTimeout(() => { t.classList.add('hiding'); setTimeout(() => t.remove(), 350); }, 4000);
}

/* ═══════════════════════════════════════════
   ANIMATED COUNTER
═══════════════════════════════════════════ */
function animCounter(el, target, decimals=0, prefix='', suffix=''){
  const dur=1300, start=performance.now();
  (function tick(now){
    const p = Math.min((now-start)/dur,1);
    const ease = 1-Math.pow(1-p,4);
    const val = (ease*target).toFixed(decimals);
    el.textContent = prefix + val + suffix;
    if(p<1) requestAnimationFrame(tick);
  })(performance.now());
}

/* ═══════════════════════════════════════════
   SEVERITY CONFIG
═══════════════════════════════════════════ */
const SEV = {
  Low:      { color:'#34d399', offset:167, cls:'badge-low',      label:'Low' },
  Medium:   { color:'#fbbf24', offset: 83, cls:'badge-medium',   label:'Medium' },
  High:     { color:'#f87171', offset:  0, cls:'badge-high',     label:'High' },
  Critical: { color:'#c084fc', offset:  0, cls:'badge-critical', label:'Critical' },
};

function updateGauge(sev){
  const cfg = SEV[sev] || { color:'#6366f1', offset:125, cls:'badge-unknown', label:sev };
  const fill = $('#gaugeFill');
  fill.style.stroke = cfg.color;
  fill.style.strokeDashoffset = cfg.offset;
  const gaugeVal = $('#gaugeValue');
  gaugeVal.textContent = cfg.label;
  gaugeVal.style.color = cfg.color;
  // severity badge on top
  const badge = $('#severityBadgeTop');
  badge.textContent = cfg.label;
  badge.className = `badge ${cfg.cls}`;
}

/* ═══════════════════════════════════════════
   BADGE HELPER
═══════════════════════════════════════════ */
function sevBadge(s){
  const map = {Low:'badge-low',Medium:'badge-medium',High:'badge-high',Critical:'badge-critical'};
  return `<span class="badge ${map[s]||'badge-unknown'}">${s||'—'}</span>`;
}

/* ═══════════════════════════════════════════
   CHARTS
═══════════════════════════════════════════ */
Chart.defaults.color = 'rgba(248,250,252,0.4)';
Chart.defaults.font.family = "'Inter', sans-serif";
let sevChart=null, atkChart=null;

function buildCharts(data){
  // Severity donut
  const sevCount = {Low:0,Medium:0,High:0,Critical:0};
  data.forEach(d => { if(sevCount[d.severity]!==undefined) sevCount[d.severity]++; });

  const sevCtx = $('#severityChart');
  if(sevChart) sevChart.destroy();
  sevChart = new Chart(sevCtx, {
    type:'doughnut',
    data:{
      labels:['Low','Medium','High','Critical'],
      datasets:[{
        data:[sevCount.Low,sevCount.Medium,sevCount.High,sevCount.Critical],
        backgroundColor:['rgba(52,211,153,.2)','rgba(251,191,36,.2)','rgba(248,113,113,.2)','rgba(192,132,252,.2)'],
        borderColor:['#34d399','#fbbf24','#f87171','#c084fc'],
        borderWidth:2, hoverOffset:8,
        hoverBackgroundColor:['rgba(52,211,153,.35)','rgba(251,191,36,.35)','rgba(248,113,113,.35)','rgba(192,132,252,.35)'],
      }]
    },
    options:{
      cutout:'70%',responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{
          backgroundColor:'rgba(6,12,26,0.95)',borderColor:'rgba(255,255,255,0.1)',borderWidth:1,
          padding:10,callbacks:{label:ctx=>` ${ctx.label}: ${ctx.parsed}`}
        }
      }
    }
  });

  // Legend
  const leg = $('#sevLegend');
  leg.innerHTML = [
    {c:'#34d399',l:'Low',v:sevCount.Low},
    {c:'#fbbf24',l:'Medium',v:sevCount.Medium},
    {c:'#f87171',l:'High',v:sevCount.High},
    {c:'#c084fc',l:'Critical',v:sevCount.Critical},
  ].map(i=>`<span style="display:flex;align-items:center;gap:5px;font-size:.73rem;color:var(--text-muted);">
    <span style="width:8px;height:8px;border-radius:50%;background:${i.c};box-shadow:0 0 6px ${i.c};"></span>${i.l} <strong style="color:var(--text)">${i.v}</strong></span>`).join('');

  // Attack vector bar
  const atkRisk={};
  data.forEach(d=>{
    const k=(d.attackType||d.attack_vector||'unknown').replace(/_/g,' ');
    if(!atkRisk[k]) atkRisk[k]={sum:0,count:0};
    atkRisk[k].sum+=(d.riskScore||0); atkRisk[k].count++;
  });
  const atkLabels=Object.keys(atkRisk);
  const atkAvgs=atkLabels.map(k=>+(atkRisk[k].sum/atkRisk[k].count).toFixed(1));

  const atkCtx=$('#attackChart');
  if(atkChart) atkChart.destroy();
  atkChart = new Chart(atkCtx,{
    type:'bar',
    data:{
      labels:atkLabels,
      datasets:[{
        label:'Avg Risk Score',
        data:atkAvgs,
        backgroundColor:atkAvgs.map(v=>v>=80?'rgba(248,113,113,.35)':v>=60?'rgba(251,191,36,.3)':'rgba(99,102,241,.35)'),
        borderColor:atkAvgs.map(v=>v>=80?'#f87171':v>=60?'#fbbf24':'#818cf8'),
        borderWidth:1.5, borderRadius:6, hoverBorderWidth:2,
      }]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{
          backgroundColor:'rgba(6,12,26,0.95)',borderColor:'rgba(255,255,255,0.1)',borderWidth:1,padding:10,
          callbacks:{label:ctx=>` Risk: ${ctx.parsed.y}`}
        }
      },
      scales:{
        x:{grid:{color:'rgba(255,255,255,.03)'},ticks:{font:{size:10},color:'rgba(248,250,252,0.35)'}},
        y:{grid:{color:'rgba(255,255,255,.05)'},min:0,max:100,ticks:{stepSize:25,color:'rgba(248,250,252,0.35)'},border:{display:false}}
      }
    }
  });
}

/* ═══════════════════════════════════════════
   LOAD HISTORY
═══════════════════════════════════════════ */
async function loadBreaches(){
  const table=$('#breachTable');
  const filterVal=$('#sevFilter').value;
  table.innerHTML=`<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-faint);">
    <div style="display:inline-flex;align-items:center;gap:8px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(99,102,241,0.6)" stroke-width="2" style="animation:spin .8s linear infinite;transform-origin:center">
        <path stroke-linecap="round" d="M4 12a8 8 0 018-8"/></svg> Loading…</div></td></tr>`;

  try{
    const res=await fetch('/api/history');
    if(!res.ok) throw new Error('Failed');
    let data=await res.json();

    // Update stats
    const total=data.length;
    const critical=data.filter(d=>d.severity==='High'||d.severity==='Critical').length;
    const avgRisk=total?Math.round(data.reduce((s,d)=>s+(d.riskScore||0),0)/total):0;
    const totalFin=data.reduce((s,d)=>s+(d.financialImpact||0),0);

    animCounter($('#statTotal'),total);
    animCounter($('#statCritical'),critical);
    animCounter($('#statAvgRisk'),avgRisk);

    // Financial total formatted
    const finEl=$('#statFinancial');
    const finFmt = totalFin>=1e9?`$${(totalFin/1e9).toFixed(2)}B`:totalFin>=1e6?`$${(totalFin/1e6).toFixed(2)}M`:totalFin>=1e3?`$${(totalFin/1e3).toFixed(1)}K`:`$${totalFin.toFixed(0)}`;
    finEl.textContent = finFmt;

    if(total>0) buildCharts(data);

    // History badge
    const hb=$('#histBadge'); hb.textContent=total; hb.style.display=total?'':'none';

    // Apply filter
    if(filterVal) data=data.filter(d=>d.severity===filterVal);

    if(!data.length){
      table.innerHTML=`<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-faint);">
        ${filterVal?`No ${filterVal} severity predictions found.`:'No predictions yet. Run your first analysis!'}</td></tr>`;
      return;
    }

    table.innerHTML = data.map(b=>{
      const date = b.createdAt ? new Date(b.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
      const finStr = b.financialImpact>=1e6?`$${(b.financialImpact/1e6).toFixed(2)}M`:b.financialImpact>=1e3?`$${(b.financialImpact/1e3).toFixed(0)}K`:`$${(b.financialImpact||0).toFixed(0)}`;
      const recs = b.records_affected || b.recordsAffected || '—';
      const recsFmt = typeof recs==='number' ? recs.toLocaleString() : recs;
      const atk = (b.attackType || b.attack_vector || '—').replace(/_/g,' ');
      const dt = (b.dataType || b.data_type || '—').replace(/_/g,' ');
      return `<tr>
        <td>${b.industry||'—'}</td>
        <td style="text-transform:capitalize;">${atk}</td>
        <td style="text-transform:capitalize;">${dt}</td>
        <td class="mono" style="font-size:.8rem;">${recsFmt}</td>
        <td>${sevBadge(b.severity)}</td>
        <td>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="mono" style="font-weight:700;font-size:.88rem;min-width:26px;">${b.riskScore||'—'}</span>
            <div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:99px;min-width:40px;overflow:hidden;">
              <div style="height:100%;width:${b.riskScore||0}%;background:linear-gradient(90deg,#6366f1,#a855f7);border-radius:99px;"></div>
            </div>
          </div>
        </td>
        <td class="mono" style="color:var(--green);font-weight:700;font-size:.85rem;">${finStr}</td>
        <td style="font-size:.75rem;color:var(--text-faint);white-space:nowrap;">${date}</td>
      </tr>`;
    }).join('');

  }catch(e){
    table.innerHTML=`<tr><td colspan="8" style="text-align:center;color:var(--red);padding:32px;font-size:.85rem;">Could not load prediction history.</td></tr>`;
  }
}

// Filter change
$('#sevFilter').addEventListener('change', loadBreaches);

/* ═══════════════════════════════════════════
   PREDICTION FORM
═══════════════════════════════════════════ */
$('#predictForm').addEventListener('submit', async function(e){
  e.preventDefault();
  const btn=$('#predictBtn'), label=$('#btnLabel'), icon=$('#btnIcon');
  btn.disabled=true;
  label.textContent='Analyzing…';
  icon.innerHTML=`<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur=".8s" repeatCount="indefinite"/><circle cx="12" cy="12" r="9" stroke-width="2" stroke-dasharray="28" stroke-dashoffset="8"/>`;

  const fd=new FormData(this);
  const payload={
    industry:        fd.get('industry'),
    attack_vector:   fd.get('attack_vector'),
    data_type:       fd.get('data_type'),
    geography:       fd.get('geography'),
    records_affected:  Number(fd.get('records_affected')),
    detection_time_hours: Number(fd.get('detection_time_hours')),
  };

  try{
    const res=await fetch('/predict',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    const result=await res.json();
    if(!res.ok) throw new Error(result.message||'Prediction failed');

    // Show result
    $('#resultEmpty').style.display='none';
    const rc=$('#resultContent');
    rc.style.display='flex';
    rc.classList.add('result-reveal');
    setTimeout(()=>rc.classList.remove('result-reveal'),700);

    updateGauge(result.severity);

    // Risk
    $('#riskValue').textContent=result.riskScore??'—';
    setTimeout(()=>{ $('#riskBar').style.width=(result.riskScore||0)+'%'; },100);

    // Financial
    const fi=result.financial_impact||result.financialImpact||0;
    const fiFmt=result.financial_impact_formatted||(fi>=1e6?`$${(fi/1e6).toFixed(2)}M`:fi>=1e3?`$${(fi/1e3).toFixed(1)}K`:`$${fi.toFixed(0)}`);
    $('#impactValue').textContent=fiFmt;
    $('#impactRaw').textContent=`$${Number(fi).toLocaleString('en-US',{maximumFractionDigits:0})} USD`;

    // Meta
    $('#modelVersion').textContent=result.model_version||result.modelVersion||'v2.0';
    $('#predTime').textContent='Analyzed '+new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});

    // Recommendations
    const recs=result.recommendations||[];
    $('#recommendations').innerHTML=recs.map(r=>`
      <div class="rec-item">
        <div class="rec-dot"></div>
        <span>${r.replace(/^[^\w\s]*/,'').trim()}</span>
      </div>`).join('');

    toast(`Prediction complete — <strong>${result.severity}</strong> severity, risk score ${result.riskScore}`,'success');
    this.reset();
    await loadBreaches();

  }catch(err){
    toast(err.message||'Prediction failed. Is the ML API running?','error');
  }finally{
    btn.disabled=false;
    label.textContent='Analyze Breach';
    icon.innerHTML=`<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`;
  }
});

/* ═══════════════════════════════════════════
   SPIN KEYFRAME (inline for the loading icon)
═══════════════════════════════════════════ */
const style=document.createElement('style');
style.textContent=`@keyframes spin{to{transform:rotate(360deg);}}`;
document.head.appendChild(style);

// Initial load
loadBreaches();
</script>
</body>
</html>
