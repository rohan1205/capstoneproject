<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Account — BreachLens</title>
  <meta name="description" content="Join BreachLens — AI-powered real-time data breach severity prediction and incident response platform."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#030712;--indigo:#6366f1;--purple:#8b5cf6;--violet:#a855f7;
      --text:#f8fafc;--muted:rgba(248,250,252,0.55);--faint:rgba(248,250,252,0.30);
      --border:rgba(255,255,255,0.08);--radius:14px;--tr:0.28s cubic-bezier(0.23,1,0.32,1);
      --green:#34d399;--red:#f87171;--yellow:#fbbf24;
    }
    html{height:100%;}
    body{
      background:var(--bg);color:var(--text);min-height:100vh;
      font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;
      display:flex;
      background-image:
        linear-gradient(rgba(99,102,241,0.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(99,102,241,0.04) 1px,transparent 1px);
      background-size:48px 48px;
    }

    /* ── BRAND PANEL ── */
    .brand-panel{
      display:none;width:46%;flex-shrink:0;
      position:relative;overflow:hidden;
      background:linear-gradient(155deg,#060c1a 0%,#0a0520 50%,#050215 100%);
      align-items:center;justify-content:center;flex-direction:column;
    }
    @media(min-width:960px){.brand-panel{display:flex;}}
    .brand-panel::before{
      content:'';position:absolute;inset:0;
      background-image:linear-gradient(rgba(99,102,241,0.065) 1px,transparent 1px),linear-gradient(90deg,rgba(99,102,241,0.065) 1px,transparent 1px);
      background-size:44px 44px;
    }
    .brand-panel::after{
      content:'';position:absolute;top:0;right:0;width:100px;height:100%;
      background:linear-gradient(90deg,transparent,var(--bg));
    }
    .bp-orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;}
    .bp-orb-1{width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,0.35) 0%,transparent 65%);top:-10%;left:-10%;animation:orbA 18s ease-in-out infinite;}
    .bp-orb-2{width:380px;height:380px;background:radial-gradient(circle,rgba(99,102,241,0.28) 0%,transparent 65%);bottom:-5%;right:10%;animation:orbA 22s ease-in-out infinite reverse;animation-delay:-6s;}
    .bp-orb-3{width:220px;height:220px;background:radial-gradient(circle,rgba(168,85,247,0.2) 0%,transparent 65%);top:35%;left:40%;animation:orbA 14s ease-in-out infinite;animation-delay:-3s;}
    @keyframes orbA{0%,100%{transform:translate(0,0);}33%{transform:translate(22px,-28px);}66%{transform:translate(-16px,18px);}}
    .brand-content{position:relative;z-index:2;padding:56px;max-width:440px;}
    .brand-logo{
      width:52px;height:52px;border-radius:14px;
      background:linear-gradient(135deg,#4f46e5,#7c3aed,#9333ea);
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 8px 28px rgba(99,102,241,0.45),inset 0 1px 0 rgba(255,255,255,0.12);
      margin-bottom:24px;
    }
    .brand-name{
      font-size:2.2rem;font-weight:900;letter-spacing:-0.04em;line-height:1.1;
      background:linear-gradient(135deg,#fff 20%,rgba(196,181,253,0.85) 60%,rgba(139,92,246,0.7) 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
      margin-bottom:6px;
    }
    .brand-sub{font-size:0.87rem;color:var(--muted);line-height:1.7;margin-bottom:32px;}
    .feature-list{display:flex;flex-direction:column;gap:12px;}
    .feature-item{
      display:flex;align-items:center;gap:12px;padding:14px 16px;
      border-radius:12px;background:rgba(255,255,255,0.035);
      border:1px solid rgba(255,255,255,0.07);transition:all var(--tr);
    }
    .feature-item:hover{background:rgba(255,255,255,0.06);border-color:rgba(99,102,241,0.22);}
    .feature-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .feature-text{font-size:0.855rem;font-weight:500;color:rgba(248,250,252,0.8);}
    .feature-desc{font-size:0.72rem;color:var(--faint);margin-top:2px;}

    /* ── AUTH PANEL ── */
    .auth-panel{
      flex:1;display:flex;align-items:center;justify-content:center;
      padding:28px;position:relative;overflow-y:auto;
    }
    .auth-shape{
      position:absolute;border-radius:18px;
      background:linear-gradient(135deg,rgba(99,102,241,0.05),rgba(139,92,246,0.02));
      border:1px solid rgba(255,255,255,0.05);pointer-events:none;
    }
    .auth-shape-1{width:90px;height:90px;top:6%;right:6%;animation:shapeF 22s ease-in-out infinite;}
    .auth-shape-2{width:55px;height:55px;bottom:10%;left:5%;animation:shapeF 28s ease-in-out infinite reverse;animation-delay:-8s;}
    @keyframes shapeF{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-14px) rotate(5deg);}}

    .form-box{
      width:100%;max-width:440px;position:relative;z-index:2;
      animation:cardUp 0.85s cubic-bezier(0.23,1,0.32,1) both;
    }
    @keyframes cardUp{from{opacity:0;transform:translateY(28px) scale(0.97);}to{opacity:1;transform:translateY(0) scale(1);}}
    @media(max-width:959px){
      .form-box{
        background:linear-gradient(145deg,rgba(255,255,255,0.07) 0%,rgba(255,255,255,0.02) 100%);
        border:1px solid rgba(255,255,255,0.12);border-radius:24px;
        padding:36px 28px;backdrop-filter:blur(24px);
        box-shadow:0 32px 80px -20px rgba(0,0,0,0.7),inset 0 1px 0 rgba(255,255,255,0.08);
      }
    }

    .form-header{text-align:center;margin-bottom:28px;}
    .form-logo{
      width:50px;height:50px;border-radius:13px;margin:0 auto 16px;
      background:linear-gradient(135deg,#7c3aed,#9333ea);
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 8px 24px rgba(139,92,246,0.4),inset 0 1px 0 rgba(255,255,255,0.1);
      transition:all 0.4s;cursor:pointer;
    }
    .form-logo:hover{transform:scale(1.07) rotate(5deg);}
    .form-title{font-size:1.7rem;font-weight:800;letter-spacing:-0.03em;margin-bottom:5px;}
    .form-subtitle{font-size:0.87rem;color:var(--muted);}

    /* ── Inputs ── */
    .input-group{position:relative;margin-bottom:18px;}
    .input-group label{
      position:absolute;left:46px;top:50%;transform:translateY(-50%);
      color:rgba(248,250,252,0.28);font-size:0.9rem;font-weight:400;
      pointer-events:none;transition:all var(--tr);
    }
    .input-group.no-icon label{left:16px;}
    .input-group input:focus ~ label,
    .input-group input:not(:placeholder-shown) ~ label{
      top:-11px;left:12px;font-size:0.67rem;font-weight:700;letter-spacing:0.07em;
      color:#818cf8;padding:0 6px;text-transform:uppercase;
      background:linear-gradient(180deg,var(--bg) 60%,transparent 40%);
    }
    .input-group .i-icon{
      position:absolute;left:15px;top:50%;transform:translateY(-50%);
      color:rgba(248,250,252,0.22);pointer-events:none;transition:color var(--tr),transform var(--tr);
    }
    .input-group input:focus ~ .i-icon{color:#818cf8;transform:translateY(-50%) scale(1.08);}
    .field{
      width:100%;padding:15px 15px 15px 46px;border-radius:var(--radius);
      background:rgba(255,255,255,0.04);border:1px solid var(--border);
      color:var(--text);font-family:'Inter',sans-serif;font-size:0.9375rem;
      outline:none;transition:all var(--tr);
    }
    .field.no-icon{padding-left:16px;}
    .field::placeholder{color:transparent;}
    .field:focus{
      border-color:rgba(99,102,241,0.6);background:rgba(255,255,255,0.06);
      box-shadow:0 0 0 3px rgba(99,102,241,0.14),inset 0 1px 0 rgba(255,255,255,0.06);
    }
    .field.valid{border-color:rgba(52,211,153,0.5);}
    .field.invalid{border-color:rgba(248,113,113,0.5);}
    .field-pw{padding-right:52px;}
    .pw-toggle{
      position:absolute;right:4px;top:50%;transform:translateY(-50%);
      width:38px;height:38px;border-radius:10px;border:none;background:none;
      color:rgba(248,250,252,0.3);cursor:pointer;transition:all var(--tr);
      display:flex;align-items:center;justify-content:center;
    }
    .pw-toggle:hover{background:rgba(255,255,255,0.06);color:#818cf8;}

    /* ── 2-col grid for name + email ── */
    .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    @media(max-width:540px){.field-grid{grid-template-columns:1fr;}}

    /* ── Strength Meter ── */
    .strength-wrap{padding:6px 2px 2px;}
    .strength-track{height:5px;border-radius:99px;background:rgba(255,255,255,0.07);overflow:hidden;}
    .strength-bar{height:100%;border-radius:99px;width:0;transition:width 0.4s cubic-bezier(0.23,1,0.32,1),background 0.3s ease;}
    .s0{width:0%;}
    .s1{width:25%;background:linear-gradient(90deg,#ef4444,#f87171);}
    .s2{width:50%;background:linear-gradient(90deg,#f59e0b,#fbbf24);}
    .s3{width:75%;background:linear-gradient(90deg,#84cc16,#a3e635);}
    .s4{width:100%;background:linear-gradient(90deg,#22c55e,#34d399);}
    .strength-text{font-size:0.69rem;font-weight:600;margin-top:5px;color:var(--faint);display:flex;align-items:center;justify-content:space-between;}
    .strength-label{transition:color 0.3s ease;}

    /* ── Match indicator ── */
    .match-indicator{
      display:none;align-items:center;gap:6px;
      font-size:0.72rem;font-weight:600;padding:6px 2px;margin-top:-10px;margin-bottom:4px;
    }
    .match-indicator.show{display:flex;}
    .match-ok{color:var(--green);}
    .match-fail{color:var(--red);}

    /* ── Password requirements ── */
    .pw-reqs{
      background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);
      border-radius:10px;padding:12px 14px;margin-bottom:4px;
      display:none;grid-template-columns:1fr 1fr;gap:6px 14px;
    }
    .pw-reqs.show{display:grid;}
    .req{display:flex;align-items:center;gap:6px;font-size:0.72rem;font-weight:500;color:var(--faint);transition:color var(--tr);}
    .req.met{color:var(--green);}
    .req-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0;transition:background var(--tr);}

    /* ── Buttons ── */
    .btn-primary{
      width:100%;padding:15px;border-radius:var(--radius);
      background:linear-gradient(135deg,#4f46e5,#7c3aed 50%,#9333ea);
      background-size:200% 200%;border:1px solid rgba(139,92,246,0.5);
      color:#fff;font-family:'Inter',sans-serif;font-size:0.95rem;font-weight:700;
      cursor:pointer;transition:all var(--tr);position:relative;overflow:hidden;
      box-shadow:inset 0 1px 0 rgba(255,255,255,0.1),0 0 40px rgba(99,102,241,0.3),0 8px 32px -8px rgba(99,102,241,0.5);
    }
    .btn-primary::before{
      content:'';position:absolute;inset:0;
      background:linear-gradient(130deg,transparent 25%,rgba(255,255,255,0.16) 50%,transparent 75%);
      transform:translateX(-120%) skewX(-15deg);transition:transform 0.7s ease;
    }
    .btn-primary:hover{transform:translateY(-2px) scale(1.01);background-position:100% 100%;box-shadow:inset 0 1px 0 rgba(255,255,255,0.14),0 0 60px rgba(139,92,246,0.45),0 12px 48px -8px rgba(99,102,241,0.55);}
    .btn-primary:hover::before{transform:translateX(120%) skewX(-15deg);}
    .btn-primary:active{transform:translateY(0) scale(0.985);}
    .btn-primary:disabled{opacity:0.5;pointer-events:none;filter:grayscale(30%);}

    .btn-google{
      width:100%;padding:14px;border-radius:var(--radius);
      background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.10);
      color:rgba(248,250,252,0.85);font-family:'Inter',sans-serif;font-size:0.9rem;font-weight:600;
      cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
      transition:all var(--tr);position:relative;overflow:hidden;
    }
    .btn-google:hover{background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.18);transform:translateY(-1px);color:var(--text);}

    /* ── Sep ── */
    .sep{display:flex;align-items:center;gap:14px;margin:22px 0;}
    .sep-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.12),transparent);}
    .sep-text{font-size:0.75rem;color:var(--faint);font-weight:500;white-space:nowrap;}

    /* ── Alert ── */
    .alert-err{
      display:flex;align-items:flex-start;gap:10px;padding:13px 15px;border-radius:var(--radius);
      background:rgba(248,113,113,0.07);border:1px solid rgba(248,113,113,0.22);
      color:#fca5a5;font-size:0.855rem;margin-bottom:20px;line-height:1.5;
      animation:alertIn 0.4s cubic-bezier(0.23,1,0.32,1) both;
    }
    @keyframes alertIn{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}

    /* ── Footer ── */
    .form-footer{text-align:center;margin-top:24px;font-size:0.875rem;color:var(--faint);}
    .form-footer a{color:#818cf8;font-weight:600;text-decoration:none;transition:color var(--tr);}
    .form-footer a:hover{color:#c4b5fd;}

    /* ── Terms ── */
    .terms{font-size:0.71rem;color:var(--faint);text-align:center;margin-top:14px;line-height:1.6;}
    .terms a{color:rgba(129,140,248,0.8);text-decoration:underline;text-underline-offset:2px;}
  </style>
</head>
<body>

  <!-- ─── LEFT BRAND PANEL ─── -->
  <div class="brand-panel">
    <div class="bp-orb bp-orb-1"></div>
    <div class="bp-orb bp-orb-2"></div>
    <div class="bp-orb bp-orb-3"></div>
    <div class="brand-content">
      <div class="brand-logo">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
          <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
      </div>
      <div class="brand-name">Join BreachLens</div>
      <p class="brand-sub">Start predicting breach severity in minutes. Get AI-powered risk scores, financial impact estimates, and expert response recommendations instantly.</p>

      <div class="feature-list">
        <div class="feature-item">
          <div class="feature-icon" style="background:rgba(99,102,241,0.15);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="feature-text">Instant Severity Classification</div>
            <div class="feature-desc">Low / Medium / High / Critical with 81% accuracy</div>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="background:rgba(16,185,129,0.12);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="feature-text">Financial Impact Estimation</div>
            <div class="feature-desc">GB Regressor — R²=0.98 accuracy</div>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="background:rgba(251,191,36,0.10);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <div>
            <div class="feature-text">Expert Response Playbooks</div>
            <div class="feature-desc">Tailored 5–11 step incident response actions</div>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="background:rgba(192,132,252,0.12);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 5.414V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <div class="feature-text">Interactive Dashboard</div>
            <div class="feature-desc">Charts, history, stats — all in real-time</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── RIGHT AUTH PANEL ─── -->
  <div class="auth-panel">
    <div class="auth-shape auth-shape-1"></div>
    <div class="auth-shape auth-shape-2"></div>

    <div class="form-box">
      <div class="form-header">
        <div class="form-logo">
          <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
            <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <div class="form-title">Create account</div>
        <div class="form-subtitle">Join BreachLens in seconds &mdash; it&rsquo;s free</div>
      </div>

      <!-- Error -->
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert-err" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f87171" style="flex-shrink:0;margin-top:1px" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/signup" method="POST" id="signupForm" autocomplete="on" novalidate>

        <!-- Name + Email row -->
        <div class="field-grid">
          <div class="input-group">
            <input type="text" name="name" id="name" placeholder=" " required autocomplete="name" class="field no-icon" style="padding-left:16px"/>
            <svg class="i-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="left:14px"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <label for="name" style="left:16px">Full Name</label>
          </div>
          <div class="input-group">
            <input type="email" name="email" id="email" placeholder=" " required autocomplete="email" class="field no-icon" style="padding-left:16px"/>
            <svg class="i-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="left:14px"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <label for="email" style="left:16px">Email</label>
          </div>
        </div>

        <!-- Password -->
        <div class="input-group">
          <input type="password" name="password" id="password" placeholder=" " required minlength="8" autocomplete="new-password" class="field field-pw"/>
          <svg class="i-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <button type="button" class="pw-toggle" id="togglePw1" aria-label="Toggle password">
            <svg id="eye1On" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <svg id="eye1Off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="display:none"><path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M4.031 11.117A8.959 8.959 0 003 12c0 4.478 2.943 8.268 7 9.543 3.947-1.192 7.26-3.408 9.542-7.187m-1.746-2.117A9.97 9.97 0 0112 5c4.478 0 8.268 2.943 9.542 7"/></svg>
          </button>
          <label for="password">Password</label>
        </div>

        <!-- Strength meter -->
        <div class="strength-wrap" id="strengthWrap" style="display:none;margin-top:-10px;margin-bottom:14px;">
          <div class="strength-track"><div class="strength-bar s0" id="strengthBar"></div></div>
          <div class="strength-text">
            <span>Strength</span>
            <span class="strength-label" id="strengthLabel"></span>
          </div>
        </div>

        <!-- PW Requirements -->
        <div class="pw-reqs" id="pwReqs">
          <div class="req" id="req-len"><span class="req-dot"></span>8+ characters</div>
          <div class="req" id="req-upper"><span class="req-dot"></span>Uppercase letter</div>
          <div class="req" id="req-lower"><span class="req-dot"></span>Lowercase letter</div>
          <div class="req" id="req-num"><span class="req-dot"></span>Number</div>
        </div>

        <!-- Confirm Password -->
        <div class="input-group" style="margin-top:14px;">
          <input type="password" name="confirmPassword" id="confirmPw" placeholder=" " required autocomplete="new-password" class="field field-pw"/>
          <svg class="i-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <button type="button" class="pw-toggle" id="togglePw2" aria-label="Toggle password">
            <svg id="eye2On" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <svg id="eye2Off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" style="display:none"><path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M4.031 11.117A8.959 8.959 0 003 12c0 4.478 2.943 8.268 7 9.543 3.947-1.192 7.26-3.408 9.542-7.187m-1.746-2.117A9.97 9.97 0 0112 5c4.478 0 8.268 2.943 9.542 7"/></svg>
          </button>
          <label for="confirmPw">Confirm Password</label>
        </div>

        <!-- Match indicator -->
        <div class="match-indicator" id="matchIndicator">
          <svg id="matchIconOk" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" style="display:none"><path d="M5 13l4 4L19 7"/></svg>
          <svg id="matchIconFail" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" style="display:none"><path d="M6 18L18 6M6 6l12 12"/></svg>
          <span id="matchText"></span>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn" style="margin-top:20px;">
          <span id="btnText">Create Account</span>
        </button>
      </form>

      <!-- Divider -->
      <div class="sep">
        <span class="sep-line"></span>
        <span class="sep-text">or sign up with</span>
        <span class="sep-line"></span>
      </div>

      <!-- Google OAuth -->
      <% if (typeof googleConfigured !== 'undefined' && googleConfigured) { %>
        <a href="/auth/google" style="text-decoration:none;display:block;">
          <button type="button" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 010-9.18l-7.98-6.19a24.06 24.06 0 000 21.56l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Continue with Google
          </button>
        </a>
      <% } %>

      <p class="form-footer">Already have an account? <a href="/login">Sign in &rarr;</a></p>
      <p class="terms">By creating an account you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</p>
    </div>
  </div>

<script>
(function(){
  // Password toggles
  function setupToggle(btnId, inputId, onId, offId){
    var btn=document.getElementById(btnId),input=document.getElementById(inputId);
    var on=document.getElementById(onId),off=document.getElementById(offId);
    if(!btn||!input) return;
    btn.addEventListener('click',function(){
      var show=input.type==='password';
      input.type=show?'text':'password';
      on.style.display=show?'none':'';off.style.display=show?'':'none';
    });
  }
  setupToggle('togglePw1','password','eye1On','eye1Off');
  setupToggle('togglePw2','confirmPw','eye2On','eye2Off');

  // Password strength
  var PW=document.getElementById('password');
  var bar=document.getElementById('strengthBar');
  var label=document.getElementById('strengthLabel');
  var wrap=document.getElementById('strengthWrap');
  var reqs=document.getElementById('pwReqs');
  var LABELS=['','Weak','Fair','Good','Strong'];
  var COLORS=['','#f87171','#fbbf24','#a3e635','#34d399'];

  function reqClass(id,met){ document.getElementById(id).classList.toggle('met',met); }
  function calcStrength(p){
    var s=0;
    if(p.length>=8)s++;if(p.length>=12)s++;
    if(/[a-z]/.test(p)&&/[A-Z]/.test(p))s++;
    if(/\d/.test(p))s++;
    if(/[^a-zA-Z0-9]/.test(p))s++;
    return Math.min(4,s);
  }

  PW.addEventListener('focus',function(){wrap.style.display='block';reqs.classList.add('show');});
  PW.addEventListener('input',function(){
    var v=PW.value, s=calcStrength(v);
    bar.className='strength-bar s'+s;
    label.textContent=v?LABELS[s]:'';
    label.style.color=v?COLORS[s]:var_faint;
    reqClass('req-len',v.length>=8);
    reqClass('req-upper',/[A-Z]/.test(v));
    reqClass('req-lower',/[a-z]/.test(v));
    reqClass('req-num',/\d/.test(v));
    if(!v){wrap.style.display='none';return;}
    wrap.style.display='block';
    checkMatch();
  });

  // Match check
  var CONF=document.getElementById('confirmPw');
  var matchDiv=document.getElementById('matchIndicator');
  var matchTxt=document.getElementById('matchText');
  var iconOk=document.getElementById('matchIconOk');
  var iconFail=document.getElementById('matchIconFail');
  function checkMatch(){
    if(!CONF.value) return;
    var ok=PW.value===CONF.value;
    matchDiv.classList.add('show');
    matchTxt.textContent=ok?'Passwords match':'Passwords do not match';
    matchTxt.className=ok?'match-ok':'match-fail';
    iconOk.style.display=ok?'':'none'; iconFail.style.display=ok?'none':'';
    CONF.classList.toggle('valid',ok); CONF.classList.toggle('invalid',!ok&&CONF.value.length>0);
  }
  CONF.addEventListener('input',checkMatch);

  // Form submit
  var form=document.getElementById('signupForm');
  var btn=document.getElementById('submitBtn');
  var btnTxt=document.getElementById('btnText');
  form.addEventListener('submit',function(e){
    if(PW.value!==CONF.value){
      e.preventDefault();
      matchDiv.classList.add('show');
      matchTxt.textContent='Passwords do not match';
      matchTxt.className='match-fail';
      iconFail.style.display=''; iconOk.style.display='none';
      CONF.focus(); return;
    }
    btn.disabled=true; btnTxt.textContent='Creating account…'; btn.style.opacity='0.8';
  });
})();
</script>
</body>
</html>
