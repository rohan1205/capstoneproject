<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>History — BreachLens</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"/>
</head>
<body class="grid-bg">
<div class="scanline"></div>
<div style="position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0">
  <div class="orb orb-indigo" style="width:480px;height:480px;top:-18%;right:-10%;opacity:.17;"></div>
  <div class="orb orb-purple" style="width:350px;height:350px;bottom:-10%;left:-8%;opacity:.13;animation-delay:-5s;"></div>
</div>
<div id="toast-container"></div>

<nav id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon"><svg width="20" height="20" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
    <div><div class="brand">BreachLens</div><div class="brand-sub">AI Security</div></div>
  </div>
  <div class="sidebar-nav">
    <div class="sidebar-section-label">Main</div>
    <a href="/dashboard" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10-3a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"/></svg><span class="label">Dashboard</span></a>
    <a href="/history" class="nav-link active"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg><span class="label">History</span></a>
    <a href="/analytics" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg><span class="label">Analytics</span></a>
    <div class="nav-divider"></div>
    <div class="sidebar-section-label">Account</div>
    <a href="/profile" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg><span class="label">Profile</span></a>
    <a href="/settings" class="nav-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/></svg><span class="label">Settings</span></a>
    <div class="nav-divider"></div>
    <a href="/logout" class="nav-link danger"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg><span class="label">Sign Out</span></a>
  </div>
  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="avatar-circle"><%= user.name.slice(0,2).toUpperCase() %></div>
      <div style="overflow:hidden;min-width:0"><div class="uname"><%= user.name %></div><div class="uemail"><%= user.email %></div></div>
    </div>
    <div style="margin-top:8px;padding:0 10px;"><div class="role-badge"><svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>Analyst</div></div>
  </div>
</nav>

<div id="main">
  <div id="topbar">
    <div style="display:flex;align-items:center;gap:14px">
      <button class="toggle-btn" id="sidebarToggle"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <div>
        <div style="font-size:.7rem;color:var(--text-faint);font-weight:500;letter-spacing:.04em;text-transform:uppercase;">Main</div>
        <div class="page-title" style="font-size:1.05rem;">Prediction History</div>
      </div>
    </div>
    <div class="topbar-right">
      <div id="clock"></div>
      <div class="avatar-circle" style="width:36px;height:36px;font-size:.73rem;flex-shrink:0"><%= user.name.slice(0,2).toUpperCase() %></div>
    </div>
  </div>

  <div class="page-content">

    <!-- Stats row -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:22px;">
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#6366f1,#8b5cf6);">
        <div class="stat-icon" style="background:rgba(99,102,241,0.12);"><svg width="18" height="18" fill="none" stroke="#818cf8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>
        <div class="stat-value" id="h-total" style="color:#818cf8;">0</div>
        <div class="stat-label">Total Records</div>
      </div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#f87171,#fb923c);animation-delay:.06s;">
        <div class="stat-icon" style="background:rgba(248,113,113,0.1);"><svg width="18" height="18" fill="none" stroke="#f87171" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div>
        <div class="stat-value" id="h-critical" style="color:#f87171;">0</div>
        <div class="stat-label">High / Critical</div>
      </div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#34d399,#10b981);animation-delay:.12s;">
        <div class="stat-icon" style="background:rgba(52,211,153,0.1);"><svg width="18" height="18" fill="none" stroke="#34d399" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg></div>
        <div class="stat-value mono" id="h-avgrisk" style="color:#34d399;font-size:1.7rem;">0</div>
        <div class="stat-label">Avg Risk Score</div>
      </div>
      <div class="glass stat-card fade-in" style="border-radius:var(--radius);--card-accent:linear-gradient(90deg,#fbbf24,#f59e0b);animation-delay:.18s;">
        <div class="stat-icon" style="background:rgba(251,191,36,0.08);"><svg width="18" height="18" fill="none" stroke="#fbbf24" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1"/></svg></div>
        <div class="stat-value mono" id="h-exposure" style="color:#fbbf24;font-size:1.35rem;">$0</div>
        <div class="stat-label">Total Exposure</div>
      </div>
    </div>

    <!-- Table -->
    <div class="glass fade-in" style="border-radius:var(--radius);padding:26px;animation-delay:.2s;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
          <div class="section-title" style="margin-bottom:0;">
            <div class="section-title-icon"><svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>
            All Predictions
          </div>
          <!-- Search -->
          <div style="position:relative;">
            <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-faint);pointer-events:none;" width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="searchInput" placeholder="Search industry, attack…" style="padding:7px 12px 7px 30px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--text);font-family:'Inter',sans-serif;font-size:.8rem;outline:none;width:210px;transition:all var(--tr);" oninput="renderTable()"/>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <select id="sevFilter" style="padding:7px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--text-muted);font-family:'Inter',sans-serif;font-size:.78rem;outline:none;cursor:pointer;" onchange="renderTable()">
            <option value="">All Severities</option>
            <option>Critical</option><option>High</option><option>Medium</option><option>Low</option>
          </select>
          <select id="sortBy" style="padding:7px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--text-muted);font-family:'Inter',sans-serif;font-size:.78rem;outline:none;cursor:pointer;" onchange="renderTable()">
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="risk-desc">Highest Risk</option>
            <option value="risk-asc">Lowest Risk</option>
            <option value="impact-desc">Highest Impact</option>
          </select>
          <button onclick="loadData()" class="ghost-btn" style="padding:7px 14px;font-size:.78rem;font-weight:600;display:flex;align-items:center;gap:6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v5h5M20 20v-5h-5"/><path d="M4 9a9 9 0 0114.24-3.24M20 15A9 9 0 015.76 18.24"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="breach-table" style="min-width:800px;">
          <thead>
            <tr>
              <th>#</th><th>Industry</th><th>Attack Vector</th><th>Data Type</th>
              <th>Geography</th><th>Records</th><th>Detect Time</th>
              <th>Severity</th><th>Risk</th><th>Financial Impact</th><th>Date</th>
            </tr>
          </thead>
          <tbody id="historyTable">
            <tr><td colspan="11" style="text-align:center;padding:48px;color:var(--text-faint);">Loading…</td></tr>
          </tbody>
        </table>
      </div>
      <div id="pagination" style="display:flex;align-items:center;justify-content:space-between;margin-top:18px;flex-wrap:wrap;gap:10px;"></div>
    </div>
  </div>
</div>

<style>.page-content{position:relative;z-index:1;}</style>
<script>
  document.getElementById('sidebarToggle').addEventListener('click',()=>{document.getElementById('sidebar').classList.toggle('collapsed');document.getElementById('main').classList.toggle('expanded');});
  function tick(){document.getElementById('clock').textContent=new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true});}tick();setInterval(tick,1000);

  var allData=[], PAGE=15, currentPage=1;

  function sevBadge(s){var m={Low:'badge-low',Medium:'badge-medium',High:'badge-high',Critical:'badge-critical'};return '<span class="badge '+(m[s]||'badge-unknown')+'">'+s+'</span>';}
  function fmtNum(n){if(n>=1e9) return '$'+(n/1e9).toFixed(2)+'B';if(n>=1e6) return '$'+(n/1e6).toFixed(2)+'M';if(n>=1e3) return '$'+(n/1e3).toFixed(0)+'K';return '$'+(n||0).toFixed(0);}

  async function loadData(){
    document.getElementById('historyTable').innerHTML='<tr><td colspan="11" style="text-align:center;padding:48px;color:var(--text-faint);">Loading…</td></tr>';
    try{
      var r=await fetch('/api/history');allData=await r.json();
      if(!Array.isArray(allData)) throw new Error();
      updateStats();renderTable();
    }catch(e){document.getElementById('historyTable').innerHTML='<tr><td colspan="11" style="text-align:center;color:var(--red);padding:40px;">Failed to load history.</td></tr>';}
  }

  function updateStats(){
    document.getElementById('h-total').textContent=allData.length;
    document.getElementById('h-critical').textContent=allData.filter(d=>d.severity==='High'||d.severity==='Critical').length;
    var avg=allData.length?Math.round(allData.reduce((s,d)=>s+(d.riskScore||0),0)/allData.length):0;
    document.getElementById('h-avgrisk').textContent=avg;
    var tot=allData.reduce((s,d)=>s+(d.financialImpact||0),0);
    document.getElementById('h-exposure').textContent=fmtNum(tot);
  }

  function renderTable(){
    var q=document.getElementById('searchInput').value.toLowerCase();
    var sf=document.getElementById('sevFilter').value;
    var sort=document.getElementById('sortBy').value;
    var filtered=allData.filter(d=>{
      if(sf && d.severity!==sf) return false;
      if(q){var s=(d.industry+d.attack_vector+d.data_type+d.geography+d.severity).toLowerCase();if(!s.includes(q)) return false;}
      return true;
    });
    if(sort==='date-desc') filtered.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
    else if(sort==='date-asc') filtered.sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));
    else if(sort==='risk-desc') filtered.sort((a,b)=>(b.riskScore||0)-(a.riskScore||0));
    else if(sort==='risk-asc') filtered.sort((a,b)=>(a.riskScore||0)-(b.riskScore||0));
    else if(sort==='impact-desc') filtered.sort((a,b)=>(b.financialImpact||0)-(a.financialImpact||0));

    var total=filtered.length;
    var pages=Math.max(1,Math.ceil(total/PAGE));
    if(currentPage>pages) currentPage=1;
    var slice=filtered.slice((currentPage-1)*PAGE, currentPage*PAGE);

    if(!slice.length){
      document.getElementById('historyTable').innerHTML='<tr><td colspan="11" style="text-align:center;padding:48px;color:var(--text-faint);">'+(allData.length?'No results match your filters.':'No predictions yet. <a href="/dashboard" style="color:var(--indigo-light);">Run your first analysis</a>.')+'</td></tr>';
      document.getElementById('pagination').innerHTML='';return;
    }
    document.getElementById('historyTable').innerHTML=slice.map((d,i)=>{
      var idx=(currentPage-1)*PAGE+i+1;
      var dt=d.createdAt?new Date(d.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'2-digit',hour:'2-digit',minute:'2-digit'}):'—';
      var rec=d.records_affected?Number(d.records_affected).toLocaleString():'—';
      var detect=d.detection_time_hours!=null?d.detection_time_hours+'h':'—';
      var atk=(d.attack_vector||'—').replace(/_/g,' ');
      var dt2=(d.data_type||'—').replace(/_/g,' ');
      var geo=(d.geography||'—').replace(/_/g,' ');
      return '<tr><td style="color:var(--text-faint);font-family:\'JetBrains Mono\',monospace;font-size:.75rem;">'+idx+'</td><td style="text-transform:capitalize;font-weight:600;">'+d.industry+'</td><td style="text-transform:capitalize;">'+atk+'</td><td style="text-transform:capitalize;">'+dt2+'</td><td style="text-transform:capitalize;">'+geo+'</td><td class="mono" style="font-size:.8rem;">'+rec+'</td><td class="mono">'+detect+'</td><td>'+sevBadge(d.severity)+'</td><td><div style="display:flex;align-items:center;gap:6px;"><span class="mono" style="font-weight:700;font-size:.85rem;min-width:24px;">'+(d.riskScore||'—')+'</span><div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:99px;min-width:36px;overflow:hidden;"><div style="height:100%;width:'+(d.riskScore||0)+'%;background:linear-gradient(90deg,#6366f1,#a855f7);border-radius:99px;"></div></div></div></td><td class="mono" style="color:#34d399;font-weight:700;font-size:.83rem;">'+fmtNum(d.financialImpact)+'</td><td style="font-size:.73rem;color:var(--text-faint);white-space:nowrap;">'+dt+'</td></tr>';
    }).join('');

    // Pagination
    var pg=document.getElementById('pagination');
    pg.innerHTML='<div style="font-size:.78rem;color:var(--text-faint);">Showing '+(slice.length)+' of '+total+' results</div><div style="display:flex;gap:6px;">'+(pages>1?Array.from({length:pages},(_,i)=>'<button onclick="goPage('+(i+1)+')" style="width:32px;height:32px;border-radius:7px;border:1px solid '+(currentPage===i+1?'rgba(99,102,241,0.5)':'var(--border)')+'background:'+(currentPage===i+1?'rgba(99,102,241,0.15)':'rgba(255,255,255,0.04)')+';color:'+(currentPage===i+1?'#818cf8':'var(--text-muted)')+';font-family:\'Inter\',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;transition:all var(--tr);">'+(i+1)+'</button>').join(''):'')+'</div>';
  }
  function goPage(n){currentPage=n;renderTable();}
  loadData();
</script>
</body>
</html>
